<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <!--
            Unit: the classes that work standalone, with no booted Laravel
            application - parsing, decryption, geometry, colors, merging.
            Fast, and the bulk of the suite.
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>

        <!--
            Integration: a real Laravel application, booted by Testbench,
            which discovers this package's service provider the same way a
            host app does. It covers the parts that only exist inside a
            framework - config merging and publishing, the container
            binding and facade, the `certigniter::` view namespace, and
            QrCodeRenderer's facade root - and renders `.igniter` fixtures
            all the way to real PDF bytes, asserting on what landed on the
            page. This is what makes support for a new major Laravel
            version something the repo asserts rather than something
            somebody once checked by hand.
        -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
