{
    "name": "certigniter/laravel-certificate-renderer",
    "description": "Open, parse, and render Certigniter .igniter certificate packages as PDFs from any Laravel app.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "certigniter",
        "certificate",
        "igniter",
        "pdf"
    ],
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "illuminate/support": "^12.0|^13.0",
        "barryvdh/laravel-dompdf": "^2.0|^3.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "picqer/php-barcode-generator": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.50|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Certigniter\\CertificateRenderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Certigniter\\CertificateRenderer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Certigniter\\CertificateRenderer\\CertificateRendererServiceProvider"
            ],
            "aliases": {
                "Certigniter": "Certigniter\\CertificateRenderer\\Facades\\Certigniter"
            }
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
